<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.05"
            android:text="HOW THE EXPERIMENT WORKS"
            android:textColor="@color/text_white"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Scientific Comparison Architecture &amp; Methodology"
            android:textColor="@color/cyan_accent"
            android:textSize="13sp" />

        <!-- Architectural Pipeline Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface_primary"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_glow_cyan"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.05"
                    android:text="SYSTEM PIPELINE FLOW"
                    android:textColor="@color/cyan_accent"
                    android:textSize="12sp" />

                <!-- Text-based ASCII Flow Diagram in sleek monospace style -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_elevated"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:padding="12dp"
                    android:text="               SAME QUESTION\n                    │\n        ┌───────────┴───────────┐\n        ↓                       ↓\n   PLAIN LLM                  RAG\n        ↓                       ↓\n  Direct Answer         Query Embedding\n                                ↓\n                          Vector Search\n                                ↓\n                         Relevant Chunks\n                                ↓\n                          LLM + Context\n                                ↓\n                         Grounded Answer\n        └───────────┬───────────┘\n                    ↓\n               EVALUATION\n                    ↓\n          Accuracy / Grounding\n         / Sources / Latency"
                    android:textColor="@color/text_white"
                    android:textSize="11sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Technical Explanations -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.05"
            android:text="CORE SYSTEM MECHANISMS"
            android:textColor="@color/text_white"
            android:textSize="14sp" />

        <!-- Plain LLM Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="System A — Plain LLM"
                android:textColor="@color/purple_bright"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="The model generates an answer directly from its learned parameters and the prompt without any external document context. This baseline provides lower latency but may hallucinate non-existent details on knowledge-heavy questions."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- RAG Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="System B — RAG (Retrieval-Augmented Generation)"
                android:textColor="@color/cyan_accent"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="The system encodes the query, searches indexed vector embeddings in FAISS/dense stores, retrieves top-k relevant document chunks, and injects this verified evidence into the LLM prompt to generate an answer with exact source citations."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Why Compare Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Why Compare?"
                android:textColor="@color/text_white"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="RAG can significantly improve factual grounding when required knowledge exists in the corpus, but it adds retrieval latency and computational overhead. This laboratory quantifies the exact trade-off."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Academic Experiment Limitations Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.05"
            android:text="EXPERIMENT LIMITATIONS"
            android:textColor="@color/yellow_amber"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_card_elevated"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="• RAG quality depends directly on retrieval quality and corpus coverage.\n• Poor or noisy documents can produce degraded RAG answers.\n• Automated factuality evaluations use heuristic approximations and semantic embeddings—not absolute ground truth.\n• Semantic similarity does not inherently equal factual veracity.\n• RAG introduces 200–500ms of additional retrieval latency.\n• Evaluation results are tied to the benchmark dataset domain distribution."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
