<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_elevated"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Index, Filename, Similarity Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSourceIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="01"
                android:textColor="@color/cyan_accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSourceFilename"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Machine Learning Fundamentals.pdf"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSourceSimilarity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_cyan"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="Sim 0.914"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Page and Section Info -->
        <TextView
            android:id="@+id/tvSourcePage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Page 12 • Chunk #0034"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Snippet / Full Text -->
        <TextView
            android:id="@+id/tvSourceSnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3dp"
            android:text="Supervised learning uses labeled training examples to learn the relationship between inputs and outputs..."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
